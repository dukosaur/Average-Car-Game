{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.DS_Store",
      "**/node_modules/**",
      "assets/*.glb",
      "assets/satellite_world_map.png",
      "assets/TerrainHeightRoadMap.png",
      "assets/*.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
